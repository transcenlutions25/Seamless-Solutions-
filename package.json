{
  "name": "seamless-solutions",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --filter @seamless/* dev",
    "build": "pnpm -r --filter @seamless/* build",
    "start": "pnpm -r --filter @seamless/* start",
    "push:github": "bash scripts/oneclick-github.sh",
    "build:web": "turbo run build --filter=@seamless/web",
    "dev:web": "turbo run dev --filter=@seamless/web"
  },
  "devDependencies": {
    "turbo": "2.1.3"
  }
}
