{
  "name": "seamless-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter @seamless/* dev",
    "build": "pnpm -r --filter @seamless/* build",
    "start": "pnpm -r --filter @seamless/* start",
    "lint": "pnpm -r --filter @seamless/* lint",
    "type-check": "pnpm -r --filter @seamless/* type-check",
    "db:generate": "cd apps/api && pnpm prisma generate",
    "db:push": "cd apps/api && pnpm prisma db push",
    "db:seed": "cd apps/api && pnpm prisma db seed",
    "db:studio": "cd apps/api && pnpm prisma studio",
    "push:github": "bash scripts/oneclick-github.sh"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}