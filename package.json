{
  "name": "seamless-solutions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter @seamless/* dev",
    "build": "pnpm build:packages && pnpm build:apps",
    "build:packages": "pnpm --filter @seamless/types build && pnpm --filter @seamless/config build && pnpm --filter @seamless/utils build",
    "build:apps": "pnpm --filter @seamless/api build && pnpm --filter @seamless/web build",
    "start": "pnpm -r --filter @seamless/* start",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test --coverage",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "prepare": "husky install",
    "docker:dev": "docker-compose -f infra/docker-compose.yml up",
    "docker:prod": "docker-compose -f infra/docker-compose.prod.yml up",
    "docker:build": "docker-compose -f infra/docker-compose.prod.yml build",
    "push:github": "bash scripts/oneclick-github.sh"
  },
  "devDependencies": {
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "turbo": "^2.1.3"
  }
}