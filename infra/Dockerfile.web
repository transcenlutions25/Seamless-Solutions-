FROM node:20-alpine AS base
WORKDIR /app
COPY apps/web/package.json ./
RUN npm i -g pnpm@9
RUN pnpm install --prefer-offline --frozen-lockfile || true
COPY apps/web ./
RUN pnpm --filter @seamless/web build

FROM node:20-alpine AS runner
WORKDIR /app
COPY --from=base /app/apps/web/.next ./.next
COPY --from=base /app/apps/web/node_modules ./node_modules
COPY --from=base /app/apps/web/package.json ./package.json
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
