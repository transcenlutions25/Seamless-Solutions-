{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": false,
    "incremental": true,
    "composite": true,
    "paths": {
      "@seamless/shared/*": ["./packages/shared/src/*"],
      "@seamless/api/*": ["./apps/api/src/*"],
      "@seamless/web/*": ["./apps/web/*"]
    }
  },
  "references": [
    { "path": "./apps/api" },
    { "path": "./apps/web" },
    { "path": "./packages/shared" }
  ],
  "include": [],
  "exclude": ["node_modules", "dist"]
}