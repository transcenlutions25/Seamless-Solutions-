// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  VENDOR
  CLIENT
}

enum ContactType {
  LEAD
  CLIENT
  VENDOR
}

enum LeadStatus {
  NEW
  QUALIFIED
  QUOTED
  WON
  LOST
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum Tier {
  BASIC
  STANDARD
  PREMIUM
}

enum Channel {
  EMAIL
  SMS
  PHONE
  WEB
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String?
  lastName    String?
  phone       String?
  role        Role     @default(STAFF)
  orgId       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  activities  ActivityLog[]
  clockIns    ClockIn[]

  @@map("users")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  timezone      String   @default("America/New_York")
  priceMultiplier Float  @default(1.0)
  stripeAccountId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users         User[]
  contacts      Contact[]
  vendors       Vendor[]
  properties    PropertyOrSite[]
  leads         Lead[]
  bids          Bid[]
  quotes        Quote[]
  jobs          Job[]
  invoices      Invoice[]
  appointments  Appointment[]
  campaigns     Campaign[]
  activities    ActivityLog[]

  @@map("organizations")
}

model Contact {
  id          String      @id @default(cuid())
  type        ContactType
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?
  tags        String[]    @default([])
  orgId       String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads       Lead[]
  quotes      Quote[]
  jobs        Job[]
  invoices    Invoice[]
  activities  ActivityLog[]

  @@map("contacts")
}

model Vendor {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  specialties   String[] @default([])
  hourlyRate    Float?
  reliabilityScore Float @default(0.0)
  onTimePercent Float    @default(0.0)
  firstPassQcPercent Float @default(0.0)
  orgId         String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs          Job[]
  clockIns      ClockIn[]
  activities    ActivityLog[]

  @@map("vendors")
}

model PropertyOrSite {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  sqft        Int?
  rooms       Int?
  floors      Int?
  notes       String?
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads       Lead[]
  bids        Bid[]
  quotes      Quote[]
  jobs        Job[]

  @@map("properties")
}

model Lead {
  id          String     @id @default(cuid())
  status      LeadStatus @default(NEW)
  source      String?
  contactId   String
  propertyId  String?
  description String?
  estimatedValue Float?
  priority    Int        @default(0)
  assignedTo  String?
  orgId       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property    PropertyOrSite? @relation(fields: [propertyId], references: [id])
  bids        Bid[]
  activities  ActivityLog[]

  @@map("leads")
}

model Bid {
  id            String   @id @default(cuid())
  leadId        String?
  propertyId    String?
  sqft          Int
  rooms         Int
  daysTarget    Int
  tier          Tier
  deepClean     Boolean  @default(false)
  pest          Boolean  @default(false)
  flooring      Boolean  @default(false)
  lawn          Boolean  @default(false)
  maintenance   Boolean  @default(false)
  deodorize     Boolean  @default(false)
  basePrice     Float
  rushMultiplier Float   @default(1.0)
  riskFactor    Float    @default(1.0)
  overhead      Float
  margin        Float
  totalPrice    Float
  notes         String?
  orgId         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead          Lead?          @relation(fields: [leadId], references: [id])
  property      PropertyOrSite? @relation(fields: [propertyId], references: [id])
  quote         Quote?

  @@map("bids")
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  bidId       String      @unique
  contactId   String
  title       String
  description String?
  validUntil  DateTime?
  totalAmount Float
  terms       String?
  notes       String?
  sentAt      DateTime?
  viewedAt    DateTime?
  orgId       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bid         Bid          @relation(fields: [bidId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  job         Job?
  activities  ActivityLog[]

  @@map("quotes")
}

model Job {
  id            String    @id @default(cuid())
  jobNumber     String    @unique
  status        JobStatus @default(SCHEDULED)
  quoteId       String    @unique
  contactId     String
  vendorId      String?
  propertyId    String?
  title         String
  description   String?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  totalAmount    Float
  notes          String?
  qcPhotos       String[] @default([])
  completionNotes String?
  orgId          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  property      PropertyOrSite? @relation(fields: [propertyId], references: [id])
  invoice       Invoice?
  clockIns      ClockIn[]
  activities    ActivityLog[]

  @@map("jobs")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  jobId         String        @unique
  contactId     String
  amount        Float
  tax           Float         @default(0.0)
  totalAmount   Float
  dueDate       DateTime?
  paidAt        DateTime?
  stripePaymentIntentId String?
  notes         String?
  orgId         String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities    ActivityLog[]

  @@map("invoices")
}

model Appointment {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  attendees   String[] @default([])
  reminders   Json?
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  type        Channel
  status      CampaignStatus @default(DRAFT)
  subject     String?
  content     String
  filters     Json?
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int            @default(0)
  opened      Int            @default(0)
  clicked     Int            @default(0)
  orgId       String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

model ClockIn {
  id          String    @id @default(cuid())
  userId      String?
  vendorId    String?
  jobId       String?
  clockInTime DateTime
  clockOutTime DateTime?
  location    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User?     @relation(fields: [userId], references: [id])
  vendor      Vendor?   @relation(fields: [vendorId], references: [id])
  job         Job?      @relation(fields: [jobId], references: [id])

  @@map("clock_ins")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String
  userId      String?
  contactId   String?
  vendorId    String?
  leadId      String?
  quoteId     String?
  jobId       String?
  invoiceId   String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  orgId       String
  createdAt   DateTime @default(now())

  // Relations
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  vendor      Vendor?      @relation(fields: [vendorId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  quote       Quote?       @relation(fields: [quoteId], references: [id])
  job         Job?         @relation(fields: [jobId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])

  @@map("activity_logs")
}