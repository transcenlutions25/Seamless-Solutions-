FROM node:20-alpine

# Install pnpm
RUN npm install -g pnpm@10.18.1

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY tsconfig.json ./

# Copy all packages
COPY packages ./packages
COPY apps/web ./apps/web

# Install dependencies
RUN pnpm install

WORKDIR /app

EXPOSE 3000

CMD ["pnpm", "--filter", "@seamless/web", "dev"]
